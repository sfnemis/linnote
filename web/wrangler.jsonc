{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "linnote-site",
  "main": "src/index.js",

  // linnote.app lives in its own Cloudflare account, and wrangler otherwise
  // takes the account from .wrangler/cache/wrangler-account.json, which held
  // SFN_IMP from another project and made every deploy fail with
  // "Authentication error [code: 10000]" against an account this token
  // cannot see. Pinning it here beats a cache nobody looks at.
  "account_id": "0c140265fee9d14ccf1998f36fbbc883",
  "compatibility_date": "2026-11-01",

  // Only ./public is published. The repository root is NEVER the web root:
  // an allowlisted directory cannot leak a file nobody thought about, a
  // denylist always can.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },

  "observability": { "enabled": true },

  // No workers.dev subdomain in this account, and none is needed.
  "workers_dev": false,

  // Routes, deliberately, not custom domains. A custom domain replaces the
  // hostname's DNS with a record Workers owns, which cannot be edited back
  // and took the apex out of service while it settled. A route leaves DNS
  // exactly as GitHub Pages had it and intercepts at the edge, so rolling
  // back is deleting two routes with no DNS propagation to wait for.
  "routes": [
    { "pattern": "linnote.app/*",     "zone_name": "linnote.app" },
    { "pattern": "www.linnote.app/*", "zone_name": "linnote.app" }
  ]
}
